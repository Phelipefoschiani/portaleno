rules_version = '2';

// O sistema do Grupo ENO hoje funciona 100% OFFLINE: todos os dados ficam no
// armazenamento local do navegador (localStorage) e o app NÃO lê nem grava no Firestore.
// Por isso, todo acesso ao banco fica NEGADO.
//
// Quando o app for conectado ao Firestore, cada coleção deve exigir usuário autenticado
// (request.auth != null) e checar o perfil/vínculo do usuário (ex.: via custom claims),
// por exemplo:
//   match /pedidos_venda/{id} {
//     allow read, write: if request.auth != null && request.auth.token.perfil == 'ADMIN';
//   }
// Nunca liberar leitura/escrita pública.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
